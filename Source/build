#!/usr/bin/env bash
set -euo pipefail

# build - Build the ArtAi RimWorld mod (macOS / Unix)

CSPROJ="ArtAi.csproj"

echo "Building project: $CSPROJ"

if command -v dotnet >/dev/null 2>&1; then
  echo "Found dotnet -> using dotnet build"
  dotnet build "$CSPROJ"
else
  echo "Error: 'dotnet' was not found in PATH." >&2
  echo "Install .NET SDK or add it to PATH, then retry." >&2
  exit 1
fi

echo "Build finished. ArtAi.dll will be placed into the OutputPath defined in the project."
