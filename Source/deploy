#!/usr/bin/env bash
set -euo pipefail

# Run from the repo root regardless of where this script is invoked from.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
cd "$REPO_ROOT"

# Where this mod gets installed.
MOD_INSTALL_DIR="$HOME/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorldMac.app/Mods/RimWorld_ArtAi"

echo "Cleaning destination folder..."
# Remove existing destination folder completely
rm -rf "$MOD_INSTALL_DIR"

# Create fresh destination directory
mkdir -p "$MOD_INSTALL_DIR"

# Copy version folders (1.*) plus mod metadata, excluding dot files/folders.
# No trailing slash on the source: rsync recreates each item (dir or file)
# under the freshly-wiped destination.
for item in 1.* About Languages LICENSE; do
    if [[ -e "$item" ]]; then
        echo "Copying $item..."
        rsync -av --exclude='.*' "$item" "$MOD_INSTALL_DIR/"
    fi
done

echo "Mod deployed successfully with complete rewrite!"
