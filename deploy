#!/usr/bin/env bash
set -euo pipefail

# Define the RimWorld mods directory path
RIMWORLD_MODS_PATH="/Users/boris/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorldMac.app/Mods/RimWorld_ArtAi"

echo "Cleaning destination folder..."
# Remove existing destination folder completely
rm -rf "$RIMWORLD_MODS_PATH"

# Create fresh destination directory
mkdir -p "$RIMWORLD_MODS_PATH"

# Copy version folders (1.*) - excluding dot files/folders
for version_dir in 1.*; do
    if [[ -d "$version_dir" ]]; then
        echo "Copying $version_dir..."
        rsync -av --exclude='.*' "$version_dir/" "$RIMWORLD_MODS_PATH/$version_dir/"
    fi
done

# Copy specific folders and files - excluding dot files/folders
for item in About Languages LICENSE; do
    if [[ -e "$item" ]]; then
        echo "Copying $item..."
        if [[ -d "$item" ]]; then
            # Directory: use rsync to exclude dot files/folders
            rsync -av --exclude='.*' "$item/" "$RIMWORLD_MODS_PATH/$item/"
        else
            # File: copy directly
            cp "$item" "$RIMWORLD_MODS_PATH/"
        fi
    fi
done

# Navigate to the destination directory
cd "$RIMWORLD_MODS_PATH"

echo "Mod deployed successfully with complete rewrite!"